# Repository-wide editor defaults. mindmap-vue3/ and tauri-spike/ have their own
# .editorconfig (root = true), which takes precedence inside those projects.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# legacy/ is a read-only historical snapshot; keep its original line endings.
[legacy/**]
end_of_line = crlf
