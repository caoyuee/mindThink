{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DesktopNaotu",
  "version": "0.1.0",
  "identifier": "org.naotu.desktopnaotu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DesktopNaotu",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2025 NaoTu Team",
    "shortDescription": "Modern mind mapping tool",
    "longDescription": "DesktopNaotu is a modern, AI-friendly mind mapping tool built with Vue3 + markmap + Tauri."
  }
}